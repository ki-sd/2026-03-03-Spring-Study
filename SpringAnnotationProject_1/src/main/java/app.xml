<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:context="http://www.springframework.org/schema/context"
	xmlns:p="http://www.springframework.org/schema/p"
	xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
		http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context-4.3.xsd">
	<context:component-scan base-package="com.sist.*"/>
	<!-- 
		메모리할당 => 클래스 위에
		 = 클래스마다 구분 = 가독성 좋게
		@Component : 일반 클래스
		             Manager
		@Repository : 저장소 => DAO
		@Service : 기능 처리 (DAO + OpenAPI)
		@Controller : Model => 브라우저 연동
		              결과값 전송 + 라우터 가능
		@RestController : JSON 전송하는 클래스
		@ControllerAdvice : 공통 예외처리
 		@Configuration : XML 대신 자바로 환경설정
 		
 		DI => 메서드,멤버변수,메서드 매개변수 위에
 		@Required : 사용자 요청값이 반드시 필요한 경우 
 		@Autowired : Spring에서 자동으로 값(주소)을 주입
 		@PostConstruct : init-method
 		@PreDestroy : destroy-method
 		@Resource : 
 		@PersistenceContext 
 		@PersistenceUnit
 		
 		interface A
 		
 		class B implements A
 		class C implements A
 		
 		@Autowired
 		@Qualifier(name="C")
 		A a;
 		
 		@Resource(name="B")
 		A a;
	 -->
</beans>
